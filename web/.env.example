# Copy to web/.env.local and edit. Vite reads .env files on its own, but bakes
# these values into the bundle when it builds, so changing one means
# rebuilding rather than restarting.
#
#   cp web/.env.example web/.env.local

# Where the API is. Must match the API's own PORT, and the API's WEB_ORIGIN
# has to allow wherever this app is served from.
VITE_API_URL=http://localhost:3000
