{
  "private": true,
  "scripts": {
    "prepare": "husky",
    "start": "docker compose up --build",
    "stop": "docker compose down",
    "dev": "docker compose up -d mongo && pnpm -r --parallel dev",
    "build": "pnpm -r --workspace-concurrency=1 build",
    "lint": "pnpm -r --workspace-concurrency=1 lint",
    "typecheck": "pnpm -r --workspace-concurrency=1 typecheck",
    "test": "pnpm -r --workspace-concurrency=1 test",
    "check:quick": "pnpm run format:check && pnpm run lint && pnpm run typecheck",
    "check": "pnpm run check:quick && pnpm run test",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "prettier": "^3.9.7"
  }
}
