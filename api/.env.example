# Copy to api/.env and edit. Nothing here is required: every variable already
# has the default shown, so the API runs from a fresh clone with no file at
# all. The real environment always wins over this file, so Docker and CI are
# unaffected by it.
#
#   cp api/.env.example api/.env

# Where MongoDB is. The default is a local server; the commented line is the
# shape MongoDB Atlas gives you. Put the database name before the `?`, or
# everything is written to a database called `test`.
MONGODB_URI=mongodb://localhost:27017/tickets
# MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/tickets?retryWrites=true&w=majority

# Signs the session tokens. Left unset, the API generates a random one and
# warns, which logs everybody out on every restart. Any long random string.
JWT_SECRET=

# The port the API listens on.
PORT=3000

# The single origin CORS allows. It has to match where the web app is served
# from, or the browser refuses every request while curl keeps working.
WEB_ORIGIN=http://localhost:5173
